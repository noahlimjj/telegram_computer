# Telegram Bot Configuration (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Authorized Telegram username (without @)
ALLOWED_USERNAME=your_telegram_username

# Primary Telegram chat ID
TELEGRAM_CHAT_ID=your_chat_id_here

# Antigravity IDE integration
# Which IDE chat Telegram messages go to: a conversation ID, or "latest" for the chat you
# last typed in. Can also be changed from Telegram with /conv.
CONVERSATION_ID=latest
